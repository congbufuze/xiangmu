{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "STLink Debug",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/watch.elf",
            "servertype": "stlink",
            "device": "STM32F411RETx",
            "interface": "swd",
            "runToEntryPoint": "main",
            "postLaunchCommands": [
                "set *(unsigned int *)0xE0042004 = *(unsigned int *)0xE0042004 | 0x3",
                "set *(unsigned int *)0xE0042008 = *(unsigned int *)0xE0042008 | 0x1000"
            ],
            "postRestartCommands": [
                "set *(unsigned int *)0xE0042004 = *(unsigned int *)0xE0042004 | 0x3",
                "set *(unsigned int *)0xE0042008 = *(unsigned int *)0xE0042008 | 0x1000"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "armToolchainPath": "C:/ST/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin",
            "serverpath": "C:/ST/STM32CubeCLT_1.18.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe"
        }
    ]
}
